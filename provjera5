function openScanner() {
  scanOverlay.classList.add('show');
  manualCodeInput.value = '';
  if (typeof Html5Qrcode === 'undefined') {
    document.getElementById('qrReader').innerHTML = '<div style="color:#888;padding:20px;text-align:center;font-size:13px;">Skener nije dostupan (nema internetske veze za učitavanje biblioteke). Koristi ručni unos ispod.</div>';
    return;
  }
  scannerStarting = true;
  html5QrCode = new Html5Qrcode("qrReader", {
    // Limiting formats (mostly 1D retail barcodes + QR) means the scanner spends
    // its time budget per frame trying far fewer symbologies, so detection is faster.
    formatsToSupport: [
      Html5QrcodeSupportedFormats.EAN_13,
      Html5QrcodeSupportedFormats.EAN_8,
      Html5QrcodeSupportedFormats.UPC_A,
      Html5QrcodeSupportedFormats.UPC_E,
      Html5QrcodeSupportedFormats.CODE_128,
      Html5QrcodeSupportedFormats.CODE_39,
      Html5QrcodeSupportedFormats.QR_CODE,
    ],
    verbose: false,
  });
  const config = {
    fps: 15,
    qrbox: { width: 280, height: 140 },
    disableFlip: true,
    // Uses the browser's native BarcodeDetector when available — much faster than the JS fallback.
    experimentalFeatures: { useBarCodeDetectorIfSupported: true },
  };
  html5QrCode.start(
    { facingMode: "environment" },
    config,
    onScanSuccess,
    () => {}
  ).then(() => { scannerStarting = false; }).catch(() => {
    scannerStarting = false;
    document.getElementById('qrReader').innerHTML = '<div style="color:#888;padding:20px;text-align:center;font-size:13px;">Nije moguće pristupiti kameri. Provjeri dozvole ili koristi ručni unos ispod.</div>';
  });
}
 
function closeScanner() {
  scanOverlay.classList.remove('show');
  if (html5QrCode) {
    const inst = html5QrCode;
    html5QrCode = null;
    if (!scannerStarting) {
      inst.stop().then(() => inst.clear()).catch(() => {});
    } else {
      // still starting up — stop as soon as it's ready to avoid a dangling camera stream
      setTimeout(() => { inst.stop().then(() => inst.clear()).catch(() => {}); }, 300);
    }
  }
}
 
function onScanSuccess(decodedText) {
  handleScannedCode(decodedText);
}
 
function handleScannedCode(code) {
  closeScanner();
  searchInput.value = code;
  clearTimeout(searchDebounceTimer);
  const results = doSearch(code) || [];
  if (results.length === 1) {
    const p = results[0];
    if (!orderItems[p.id]) orderItems[p.id] = { id: p.id, name: p.name, sku: p.sku, qty: 0 };
    orderItems[p.id].qty += 1;
    saveOrder();
    updateCartBadge();
    updateProductCardUI(p.id);
    showToast(`Skenirano: ${p.name} (${orderItems[p.id].qty} kom u narudžbi)`);
  } else if (results.length > 1) {
    showToast(`Pronađeno ${results.length} rezultata za "${code}"`);
  } else {
    showToast(`Nema proizvoda za kod "${code}"`);
  }
}
 
scanBtn.addEventListener('click', openScanner);
scanCancelBtn.addEventListener('click', closeScanner);
manualCodeInput.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && manualCodeInput.value.trim()) {
    handleScannedCode(manualCodeInput.value.trim());
  }
});
 
function initFromStorage() {
  try {
    const saved = localStorage.getItem('provjera_products');
    const savedMap = localStorage.getItem('provjera_colmap');
    if (saved) {
      allProducts = JSON.parse(saved);
      // Backfill lowercase fields for data saved before this optimization existed.
      let needsBackfill = false;
      for (let i = 0; i < allProducts.length; i++) {
        const p = allProducts[i];
        if (typeof p.nameLower !== 'string') { p.nameLower = (p.name || '').toLowerCase(); needsBackfill = true; }
        if (typeof p.skuLower !== 'string') { p.skuLower = (p.sku || '').toLowerCase(); needsBackfill = true; }
      }
      if (savedMap) colMap = JSON.parse(savedMap);
      rebuildIndex();
      statsPill.style.display = 'inline';
      statsPill.textContent = `${allProducts.length} proizvoda`;
      uploadLabel.textContent = 'Zamijeni datoteku';
      uploadHint.textContent = 'Podaci su sačuvani lokalno';
      renderProducts(allProducts, '');
      if (needsBackfill) {
        try { localStorage.setItem('provjera_products', JSON.stringify(allProducts)); } catch(e) {}
      }
    }
  } catch(e) {}
  loadOrder();
  loadSavedOrders();
}
 
// html5-qrcode / xlsx / jspdf load with `defer` now, so make sure the DOM/data
// wiring above runs only after the document (and those scripts) are ready.
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initFromStorage);
} else {
  initFromStorage();
}
 
const _origBuild = buildProducts;
window.buildProducts = function() {
  _origBuild();
  try {
    localStorage.setItem('provjera_products', JSON.stringify(allProducts));
    localStorage.setItem('provjera_colmap', JSON.stringify(colMap));
  } catch(e) {}
};
