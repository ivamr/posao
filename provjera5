function todayStr() {
  const d = new Date();
  return d.toLocaleDateString('hr-HR') + ' ' + d.toLocaleTimeString('hr-HR', {hour:'2-digit', minute:'2-digit'});
}

// Renders a CODE128 barcode for an order item (uses the SKU if there is one,
// otherwise falls back to a stable per-row ID) onto an offscreen canvas and
// returns a PNG data URL plus its pixel size. Used by both the PDF and Excel
// exports so the barcode logic + look lives in one place.
function barcodeCodeFor(it) {
  return it.sku ? String(it.sku) : `ID${it.id}`;
}
function generateBarcodeImage(text) {
  if (typeof JsBarcode === 'undefined') return null;
  try {
    const canvas = document.createElement('canvas');
    JsBarcode(canvas, String(text || ' '), {
      format: 'CODE128',
      displayValue: true,
      fontSize: 14,
      textMargin: 2,
      height: 40,
      margin: 4,
    });
    return { dataUrl: canvas.toDataURL('image/png'), width: canvas.width, height: canvas.height };
  } catch (e) {
    return null; // e.g. characters CODE128 can't encode — caller shows '-' instead
  }
}
// docx.js (and some canvas exports) want raw bytes rather than a data URL.
function dataUrlToUint8Array(dataUrl) {
  const base64 = dataUrl.split(',')[1];
  const binary = atob(base64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return bytes;
}
 
document.getElementById('exportCsvBtn').addEventListener('click', () => {
  const items = Object.values(orderItems);
  if (items.length === 0) return;
  let csv = '';
  if (customerNameInput.value.trim()) csv += `Kupac;${customerNameInput.value.trim()}\n`;
  csv += 'Naziv;Šifra;Količina\n';
  items.forEach(it => {
    csv += `"${it.name.replace(/"/g,'""')}";"${it.sku || ''}";${it.qty}\n`;
  });
  const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `narudzba_${new Date().toISOString().slice(0,10)}.csv`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  showToast('CSV izvezen');
});
 
document.getElementById('exportExcelBtn').addEventListener('click', async () => {
  const items = Object.values(orderItems);
  if (items.length === 0) return;
  if (typeof ExcelJS === 'undefined') { showToast('Excel biblioteka nije učitana'); return; }
  try {
    const customer = customerNameInput.value.trim();
    const wb = new ExcelJS.Workbook();
    const ws = wb.addWorksheet('Narudžba');
    ws.columns = [
      { key: 'name', width: 40 },
      { key: 'sku', width: 16 },
      { key: 'barcode', width: 28 },
      { key: 'qty', width: 10 },
    ];

    let headerRowNum = 1;
    if (customer) {
      ws.getCell('A1').value = 'Kupac:';
      ws.getCell('A1').font = { bold: true };
      ws.getCell('B1').value = customer;
      headerRowNum = 2;
    }
    ws.getRow(headerRowNum).values = ['Naziv', 'Šifra', 'Barkod', 'Količina'];
    ws.getRow(headerRowNum).font = { bold: true };
    ws.getRow(headerRowNum).height = 20;

    items.forEach((it, i) => {
      const rowNum = headerRowNum + 1 + i;
      ws.getRow(rowNum).values = [it.name, it.sku || '', '', it.qty];
      ws.getRow(rowNum).height = 40;
      ws.getRow(rowNum).alignment = { vertical: 'middle' };

      const bc = generateBarcodeImage(barcodeCodeFor(it));
      if (bc) {
        const imageId = wb.addImage({ base64: bc.dataUrl, extension: 'png' });
        const targetH = 34;
        const targetW = bc.width * (targetH / bc.height);
        ws.addImage(imageId, {
          tl: { col: 2, row: rowNum - 1 }, // 0-indexed anchor: column C ("Barkod"), this row
          ext: { width: targetW, height: targetH },
        });
      }
    });

    const buf = await wb.xlsx.writeBuffer();
    const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `narudzba_${new Date().toISOString().slice(0,10)}.xlsx`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast('Excel izvezen (s barkodovima)');
  } catch (err) {
    console.error(err);
    showToast('Greška pri izradi Excela');
  }
});
 
document.getElementById('exportPdfBtn').addEventListener('click', () => {
  const items = Object.values(orderItems);
  if (items.length === 0) return;
  try {
    const customer = customerNameInput.value.trim();
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();
    doc.setFontSize(16);
    doc.text('Narudzba za skladiste', 14, 18);
    doc.setFontSize(10);
    doc.setTextColor(90);
    doc.text(todayStr(), 14, 25);
    let tableStartY = 32;
    if (customer) {
      doc.setTextColor(20);
      doc.text(`Kupac: ${customer}`, 14, 31);
      tableStartY = 38;
    }
    const totalQty = items.reduce((s, it) => s + it.qty, 0);

    // Pre-generate each row's barcode image so it's ready when didDrawCell fires.
    const barcodes = items.map(it => generateBarcodeImage(barcodeCodeFor(it)));

    doc.autoTable({
      startY: tableStartY,
      head: [['Naziv', 'Sifra', 'Barkod', 'Kolicina']],
      body: items.map(it => [it.name, it.sku || '-', '', String(it.qty)]),
      styles: { fontSize: 10, cellPadding: 4, minCellHeight: 18 },
      headStyles: { fillColor: [40, 40, 45] },
      columnStyles: { 2: { cellWidth: 55 }, 3: { halign: 'right' } },
      foot: [['', '', 'Ukupno', String(totalQty)]],
      footStyles: { fillColor: [240, 240, 240], textColor: 20, fontStyle: 'bold' },
      didDrawCell: (data) => {
        if (data.section !== 'body' || data.column.index !== 2) return;
        const bc = barcodes[data.row.index];
        if (!bc) return;
        const maxW = data.cell.width - 4;
        const maxH = data.cell.height - 4;
        const ratio = Math.min(maxW / bc.width, maxH / bc.height);
        const w = bc.width * ratio;
        const h = bc.height * ratio;
        const x = data.cell.x + (data.cell.width - w) / 2;
        const y = data.cell.y + (data.cell.height - h) / 2;
        doc.addImage(bc.dataUrl, 'PNG', x, y, w, h);
      },
    });
    doc.save(`narudzba_${new Date().toISOString().slice(0,10)}.pdf`);
    showToast('PDF izvezen');
  } catch (err) {
    showToast('Greška pri izradi PDF-a');
  }
});
 
document.getElementById('exportWordBtn').addEventListener('click', async () => {
  const items = Object.values(orderItems);
  if (items.length === 0) return;
  if (typeof docx === 'undefined') { showToast('Word biblioteka nije učitana'); return; }
  try {
    const { Document, Packer, Table, TableRow, TableCell, Paragraph, ImageRun, TextRun, WidthType, HeadingLevel } = docx;
    const totalQty = items.reduce((s, it) => s + it.qty, 0);

    const headerCell = (text) => new TableCell({
      width: { size: 25, type: WidthType.PERCENTAGE },
      children: [new Paragraph({ children: [new TextRun({ text, bold: true })] })],
    });
    const headerRow = new TableRow({
      tableHeader: true,
      children: ['Naziv', 'Šifra', 'Barkod', 'Količina'].map(headerCell),
    });

    const rows = items.map(it => {
      const bc = generateBarcodeImage(barcodeCodeFor(it));
      let barcodeCellChildren;
      if (bc) {
        const targetH = 30;
        const targetW = bc.width * (targetH / bc.height);
        barcodeCellChildren = [new Paragraph({
          children: [new ImageRun({
            type: 'png',
            data: dataUrlToUint8Array(bc.dataUrl),
            transformation: { width: targetW, height: targetH },
          })],
        })];
      } else {
        barcodeCellChildren = [new Paragraph('—')];
      }
      return new TableRow({
        children: [
          new TableCell({ children: [new Paragraph(it.name)] }),
          new TableCell({ children: [new Paragraph(it.sku || '—')] }),
          new TableCell({ children: barcodeCellChildren }),
          new TableCell({ children: [new Paragraph(String(it.qty))] }),
        ],
      });
    });

    const table = new Table({
      width: { size: 100, type: WidthType.PERCENTAGE },
      rows: [headerRow, ...rows],
    });

    const customer = customerNameInput.value.trim();
    const doc = new Document({
      sections: [{
        children: [
          new Paragraph({ text: 'Narudžba za skladište', heading: HeadingLevel.HEADING_1 }),
          new Paragraph({ text: todayStr() }),
          ...(customer ? [new Paragraph({ children: [new TextRun({ text: `Kupac: ${customer}`, bold: true })] })] : []),
          new Paragraph({ text: '' }),
          table,
          new Paragraph({ text: '' }),
          new Paragraph({ text: `Ukupno stavki: ${items.length} · Ukupno komada: ${totalQty}` }),
        ],
      }],
    });

    const blob = await Packer.toBlob(doc);
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `narudzba_${new Date().toISOString().slice(0,10)}.docx`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast('Word dokument izvezen');
  } catch (err) {
    console.error(err);
    showToast('Greška pri izradi Word dokumenta');
  }
});

